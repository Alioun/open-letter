{$DOMAIN} {
    # The app listens on PORT from .env; docker-compose.proxy.yml passes it on.
    reverse_proxy app:{$PORT:3000} {
        # Caddy puts the peer it saw into X-Forwarded-For, which is what the
        # app keys its rate limits on. X-Real-IP would otherwise pass through
        # as the client sent it; overwrite it so no spoofed value gets behind
        # this proxy.
        header_up X-Real-IP {remote_host}
    }
}
