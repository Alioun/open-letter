# Letter directory under config/letters/. Defaults to example.
# Supplies initial content, branding, theme, email settings, and feature flags.
LETTER_CONFIG=example

# Encrypted SQLite database path.
DATABASE_PATH=./data/diaetendeckel.db
# Required SQLCipher passphrase. Startup fails if it is missing.
DATABASE_ENCRYPTION_KEY=change-me-to-a-long-random-secret
# Backup key is required in production. Development defaults to the database key.
# BACKUP_ENCRYPTION_KEY=
# Source Postgres connection string for a one-time migration.
# SOURCE_DATABASE_URL=postgres://user:password@host:5432/diaetendeckel
# Honker extension for durable jobs. Defaults depend on the platform.
# macOS uses ./vendor/libhonker_ext.dylib; Linux uses /app/vendor/libhonker_ext.so.
# HONKER_EXTENSION_PATH=./vendor/libhonker_ext.dylib
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development
ADMIN_PATH=replace-with-secret-segment
ADMIN_PASSWORD=change-me
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret
# Public API signing secret. Use a different value from ADMIN_JWT_SECRET in production.
API_TOKEN_SECRET=change-me-to-a-different-long-random-secret
# Encrypted backups must use a separate encryption key in production.
BACKUP_ENCRYPTION_KEY=change-me-to-a-unique-random-secret
# Initial email provider, resend or smtp. Overrides email.provider in the letter config.
# A database-managed profile replaces these connection settings.
# EMAIL_PROVIDER=resend
# Optional sender override for either provider (alias of RESEND_FROM).
# EMAIL_FROM=noreply@letter.example.org

# Resend credentials when using provider=resend.
RESEND_API_KEY=re_your_api_key
RESEND_FROM=noreply@letter.example.org

# SMTP credentials when using provider=smtp.
# Host, port, and TLS settings override email.smtp in the letter config.
# These credentials apply to the deployment-managed profile.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587            # 465 = implicit TLS, 587 = STARTTLS
# SMTP_SECURE=false        # true only for port 465
# SMTP_USER=apikey-or-username
# SMTP_PASS=your-smtp-password

# Sending delays in milliseconds. Override email.pacing in the letter config.
# EMAIL_MESSAGE_DELAY_MS=550   # between one-by-one sends (zoom link mailing)
# EMAIL_BATCH_DELAY_MS=1000    # between 100-email batch chunks (campaigns, reminders)
# Meeting label for confirmation email and optional Zoom link.
# Link email waits until ZOOM_LINK is set. The default send time is one day before the event.
ZOOM_EVENT_LABEL=9. Juni, 20 Uhr
ZOOM_LINK=
# Meeting timestamp in ISO format, including its timezone, and calendar duration.
# Default mail times are one day before for the link and two hours before for the reminder.
ZOOM_EVENT_AT=2026-06-09T20:00:00+02:00
ZOOM_EVENT_DURATION_MIN=90
